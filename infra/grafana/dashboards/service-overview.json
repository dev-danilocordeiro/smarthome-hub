      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_route=~\"$route\"}[$__rate_interval])) * 0) / sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
