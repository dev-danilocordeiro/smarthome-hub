{
 "uid": "energy-notifications",
 "title": "Energy and Notifications",
 "description": "The energy rollup, alert transitions and the notification delivery queue (ADR 0012, 0013).",
 "tags": [
  "smarthome",
  "energy",
  "alerts"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 41,
 "version": 1,
 "templating": {
  "list": []
 },
 "links": [
  {
   "title": "Service Overview",
   "type": "link",
   "url": "/d/service-overview"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Rollup lag p95",
   "description": "p95 of how far behind now the rollup cursor was when a run started (normally about one interval).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(smarthome_energy_rollup_lag_seconds_bucket[$__rate_interval])))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 300
       },
       {
        "color": "red",
        "value": 1800
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Alerts opened (1h)",
   "description": "Alerts that opened in the last hour, all homes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(smarthome_alerts_transitions_total{transition=\"opened\"}[1h])) or vector(0)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
