{
 "uid": "device-pipeline",
 "title": "Device Pipeline",
 "description": "MQTT in, TimescaleDB out: ingestion rate, latency, batching, back-pressure and the device event stream (ADR 0007, 0010).",
 "tags": [
  "smarthome",
  "ingestion",
  "telemetry"
 ],
 "timezone": "browser",
 "editable": false,
 "graphTooltip": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 41,
 "version": 1,
 "templating": {
  "list": []
 },
 "links": [
  {
   "title": "Service Overview",
   "type": "link",
   "url": "/d/service-overview"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Messages accepted /s",
   "description": "Device messages that passed validation, ACL and the active-device check.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum (rate(smarthome_ingestor_messages_total{outcome=\"accepted\"}[$__rate_interval]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Rows written /s",
   "description": "Readings inserted into telemetry.readings (one per metric per message).",
