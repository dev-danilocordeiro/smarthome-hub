# GENERATED by scripts/gen_import_contracts.py. Do not edit by hand.
[importlinter]
root_package = smarthome
include_external_packages = True

[importlinter:contract:module-layers]
name = Each module is layered api -> infrastructure -> application -> domain
type = layers
layers =
    api
    infrastructure
    application
    domain
containers =
    smarthome.modules.automations
    smarthome.modules.commands
    smarthome.modules.devices
    smarthome.modules.energy
    smarthome.modules.identity
    smarthome.modules.notifications
    smarthome.modules.telemetry

[importlinter:contract:pure-domain]
name = Domain layers import no frameworks and no shared infrastructure
type = forbidden
source_modules =
    smarthome.modules.*.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    pydantic
    redis
    smarthome.shared.infrastructure

[importlinter:contract:shared-kernel]
name = The shared kernel never depends on a module
type = forbidden
source_modules =
    smarthome.shared
forbidden_modules =
    smarthome.modules

[importlinter:contract:entrypoints]
name = Modules never import an entrypoint
type = forbidden
source_modules =
    smarthome.modules
forbidden_modules =
    smarthome.main

