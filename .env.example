# Copied to .env by `make up` when missing. Never commit .env.
# Host ports are offset (15432, 16379) so this stack can run next to other local projects.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome-dev-only
POSTGRES_DB=smarthome
POSTGRES_PORT=15432

# --- Redis ---
REDIS_PORT=16379

# --- API ---
API_PORT=8000
SMARTHOME_ENVIRONMENT=local
SMARTHOME_LOG_LEVEL=INFO
SMARTHOME_LOG_JSON=true
# Used when running the API outside Docker (make api-dev). Inside compose these are overridden.
SMARTHOME_DATABASE_URL=postgresql+asyncpg://smarthome:smarthome-dev-only@localhost:15432/smarthome
SMARTHOME_REDIS_URL=redis://localhost:16379/0

# --- Observability (infra/docker-compose.observability.yml) ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-dev-only
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
TEMPO_PORT=3200
LOKI_PORT=3100
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Exposes /diagnostics/trace-demo, used by the README tour and `make demo-traffic`.
SMARTHOME_DIAGNOSTICS_ENABLED=true

# --- Identity (Keycloak + BFF) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
# Must match the smarthome-bff client secret in infra/keycloak/realm-export.json.
OIDC_CLIENT_SECRET=dev-only-bff-secret-change-me
WEB_APP_URL=http://localhost:5173

# --- Email (Mailpit catches everything in development) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- MQTT broker (Mosquitto, TLS only) ---
MQTT_TLS_PORT=8883
# Dynamic-security admin: manages device credentials and ACLs. Only the hub uses it.
MQTT_ADMIN_USER=hub-admin
MQTT_ADMIN_PASSWORD=mqtt-admin-dev-only
# The hub's own MQTT account (ingestor/commands); created by the ingestor on first start.
MQTT_HUB_PASSWORD=mqtt-hub-dev-only
# Broker address handed to devices when they pair.
DEVICE_BROKER_HOST=localhost
# Pairing claims per IP per minute. 10 in production; high in dev so `make simulate` pairs 60 devices at once.
CLAIM_RATE_PER_MINUTE=500
